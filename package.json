{
  "name": "rosebankart",
  "version": "0.1.0",
  "private": true,
  "description": "Rosebank Art Centre — community art facility in Te Awamutu, NZ",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply rosebankart-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rosebankart-db --remote",
    "archive": "node scripts/archive-wp.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:seed:local": "wrangler d1 execute rosebankart-db --local --file=data/archive-seed.sql",
    "db:seed:remote": "wrangler d1 execute rosebankart-db --remote --file=data/archive-seed.sql",
    "migrate": "node scripts/migrate.mjs",
    "build:check": "NEXT_DIST_DIR=.next-build next build"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "drizzle-orm": "^0.44.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.20.0"
  }
}
