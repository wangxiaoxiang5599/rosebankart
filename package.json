{
  "name": "rosebankart",
  "version": "0.1.0",
  "private": true,
  "description": "Rosebank Art Centre — community art facility in Te Awamutu, NZ",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply rosebankart-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rosebankart-db --remote",
    "archive": "node scripts/archive-wp.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:seed:local": "wrangler d1 execute rosebankart-db --local --file=data/archive-seed.sql",
    "db:seed:remote": "wrangler d1 execute rosebankart-db --remote --file=data/archive-seed.sql",
    "migrate": "node scripts/migrate.mjs",
    "import:facebook": "node scripts/import-facebook.mjs",
    "db:seed:facebook:local": "wrangler d1 execute rosebankart-db --local --file=data/facebook-seed.sql",
    "db:seed:facebook:remote": "wrangler d1 execute rosebankart-db --remote --file=data/facebook-seed.sql",
    "build:check": "NEXT_DIST_DIR=.next-build next build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "esbuild": "^0.25.4",
    "sharp": "^0.35.4"
  }
}
