{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rosebankart",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "routes": [
    {
      "pattern": "rosebankart.wangxiaoxiang.com",
      "custom_domain": true
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rosebankart-db",
      "database_id": "4885b90d-cf5b-4ed4-a9bb-7173c0719b66",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "rosebankart-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "rosebankart-cache"
    }
  ]
}
